@echo off
rem present.hlsl to present_shaders.h with the Windows SDK's fxc; run after editing the shader, commit both
setlocal
cd /d %~dp0
set FXC=
for /f "delims=" %%f in ('dir /b /s "%ProgramFiles(x86)%\Windows Kits\10\bin\*fxc.exe" 2^>nul ^| findstr /i x64') do set FXC=%%f
if "%FXC%"=="" (echo fxc.exe not found & exit /b 1)
"%FXC%" /nologo /T vs_5_0 /E vs /O3 /Vn kPresentVs /Fh vs.h present.hlsl || exit /b 1
"%FXC%" /nologo /T ps_5_0 /E ps_easu /O3 /Vn kPresentEasu /Fh easu.h present.hlsl || exit /b 1
"%FXC%" /nologo /T ps_5_0 /E ps_final /O3 /Vn kPresentFinal /Fh final.h present.hlsl || exit /b 1
(echo // generated by build.bat from present.hlsl: do not edit
 echo #pragma once
 type vs.h easu.h final.h) > present_shaders.h
del vs.h easu.h final.h
